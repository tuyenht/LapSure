{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-x64-release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/msvc-x64-release",
      "cacheVariables": { "LAPSURE_STRICT_WARNINGS": "OFF" }
    },
    {
      "name": "msvc-x64-ci",
      "inherits": "msvc-x64-release",
      "binaryDir": "${sourceDir}/out/build/msvc-x64-ci",
      "cacheVariables": { "LAPSURE_STRICT_WARNINGS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "build-msvc-x64-release", "configurePreset": "msvc-x64-release", "configuration": "Release" },
    { "name": "build-msvc-x64-ci", "configurePreset": "msvc-x64-ci", "configuration": "Release" }
  ]
}
