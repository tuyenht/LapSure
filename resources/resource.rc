#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,1,0
PRODUCTVERSION  0,1,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LapSure"
            VALUE "FileDescription",  "LapSure - Kiem dinh & Chan doan Laptop Toan dien"
            VALUE "FileVersion",      "0.1.1.0"
            VALUE "InternalName",     "LapSure.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 LapSure. All rights reserved."
            VALUE "OriginalFilename", "LapSure.exe"
            VALUE "ProductName",      "LapSure Laptop Verification"
            VALUE "ProductVersion",   "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
